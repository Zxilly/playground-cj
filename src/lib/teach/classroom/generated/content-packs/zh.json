          "type": "code_sample",
          "code": "main() {\n    // 定义可变绑定\n    var count = 0\n    println(\"初始值: ${count}\")\n    \n    // 可以多次修改 var 变量的值\n    count = 10\n    println(\"第一次修改: ${count}\")\n    \n    count = count + 5\n    println(\"第二次修改: ${count}\")\n    \n    // 另一个可变绑定示例\n    var message = \"hello\"\n    message = \"world\"  // 可以修改\n    println(\"消息: ${message}\")\n    \n    // 不支持链式赋值：\n    // var a = 0\n    // var b = 0\n    // a = b = 1  // 语法错误\n}",
          "language": "cangjie",
