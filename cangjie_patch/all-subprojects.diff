+// Copyright (c) Huawei Technologies Co., Ltd. 2025. All rights reserved.
+// This source file is part of the Cangjie project, licensed under Apache-2.0
+// with Runtime Library Exception.
+//
+// See https://cangjie-lang.cn/pages/LICENSE for license information.
+
+#include "Format/FormatCodeProcessor.h"
+#include "Format/OptionContext.h"
+
+#include <emscripten/bind.h>
+
+#include <string>
+#include <utility>
+
+namespace {
+struct FormatResult {
+    bool success;
+    std::string formatted;
+};
+
+FormatResult FormatCangjie(const std::string& source, const std::string& path)
+{
+    Cangjie::Format::OptionContext::GetInstance().SetConfigOptions(Cangjie::Format::FormattingOptions{});
+    auto formatted = Cangjie::Format::FormatText(
+        source, path.empty() ? "main.cj" : path, Cangjie::Format::Region::wholeFile);
+    if (!formatted.has_value()) {
+        return {false, source};
+    }
+    return {true, std::move(formatted.value())};
+}
+} // namespace
+
+EMSCRIPTEN_BINDINGS(cangjie_formatter)
+{
+    emscripten::value_object<FormatResult>("FormatResult")
+        .field("success", &FormatResult::success)
+        .field("formatted", &FormatResult::formatted);
+    emscripten::function("formatCangjie", &FormatCangjie);
+}
