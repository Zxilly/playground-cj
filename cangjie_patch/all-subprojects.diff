diff --git a/cangjie_tools/cangjie-language-server/src/wasm/WasmTransport.cpp b/cangjie_tools/cangjie-language-server/src/wasm/WasmTransport.cpp
new file mode 100644
index 00000000..336894c4
--- /dev/null
+++ b/cangjie_tools/cangjie-language-server/src/wasm/WasmTransport.cpp
@@ -0,0 +1,231 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2025. All rights reserved.
+// This source file is part of the Cangjie project, licensed under Apache-2.0
+// with Runtime Library Exception.
+//
+// See https://cangjie-lang.cn/pages/LICENSE for license information.
+
+#ifdef BUILD_WASM
+
+#include "WasmTransport.h"
+#include "../languageserver/capabilities/shutdown/Shutdown.h"
+#include "../languageserver/logger/Logger.h"
+
+namespace ark {
+
+nlohmann::json WasmTransport::EncodeError(const MessageErrorDetail &errorInfo)
+{
+    nlohmann::json root;
+    root["message"] = errorInfo.message;
+    root["code"] = static_cast<int64_t>(errorInfo.code);
+    return root;
+}
+
+MessageErrorDetail WasmTransport::DecodeError(const nlohmann::json &o)
+{
+    std::string msg = o.contains("message") ? o.value("message", "") : "Unspecified error";
+    ErrorCode code = o.contains("code") ? ErrorCode(o.value("code", -1)) : ErrorCode::UNKNOWN_ERROR_CODE;
+    return {msg, code};
+}
+
+void WasmTransport::Notify(std::string method, ValueOrError params)
+{
+    nlohmann::json root;
+    root["jsonrpc"] = "2.0";
+    root["method"] = method;
+    if (params.type == ValueOrErrorCheck::VALUE) {
+        root["params"] = std::move(params.jsonValue);
+    } else {
+        root["error"] = EncodeError(params.errorInfo);
+    }
+    SendToJS(root);
+}
+
+void WasmTransport::Reply(nlohmann::json id, ValueOrError result)
+{
+    nlohmann::json root;
+    root["jsonrpc"] = "2.0";
+    root["id"] = std::move(id);
+    if (result.type == ValueOrErrorCheck::VALUE) {
+        root["result"] = std::move(result.jsonValue);
+    } else {
+        root["error"] = EncodeError(result.errorInfo);
+    }
+    SendToJS(root);
+}
+
+void WasmTransport::SendToJS(const nlohmann::json &message)
+{
+    std::stringstream log;
+    std::ostringstream os;
+    os << message.dump(-1, ' ', false, nlohmann::json::error_handler_t::ignore);
+
+    std::string msgStr = os.str();
+
+    CleanAndLog(log, "send message body:" + msgStr);
+    Logger::Instance().LogMessage(MessageType::MSG_INFO, log.str());
+
+    // Use the registered callback to send message to JavaScript
+    if (jsCallback) {
+        jsCallback(msgStr.c_str());
+    }
+}
+
+void WasmTransport::ReceiveMessage(const std::string &message)
+{
+    std::lock_guard<std::mutex> lock(queueMutex);
+    messageQueue.push(message);
+    queueCondition.notify_one();
+}
+
+LSPRet WasmTransport::ProcessSingleMessage(MessageHandler &handler)
+{
+    Logger &logger = Logger::Instance();
+    std::stringstream log;
+
+    std::string json;
+    {
+        std::lock_guard<std::mutex> lock(queueMutex);
+        if (messageQueue.empty()) {
+            return LSPRet::SUCCESS;
+        }
+        json = messageQueue.front();
+        messageQueue.pop();
+    }
+
+    if (json.empty()) {
+        return LSPRet::SUCCESS;
+    }
+
+    CleanAndLog(log, "receive message body:" + json);
+    logger.LogMessage(MessageType::MSG_INFO, log.str());
+    logger.CollectMessageInfo(logger.LogInfo(MessageType::MSG_INFO, json));
+
+    nlohmann::json doc;
+#ifndef NO_EXCEPTIONS
+    try {
+#endif
+        doc = nlohmann::json::parse(json);
+#ifndef NO_EXCEPTIONS
+    } catch (nlohmann::detail::parse_error &errs) {
+        CleanAndLog(log, errs.what());
+        logger.LogMessage(MessageType::MSG_WARNING, log.str());
+        return LSPRet::ERR_JSON;
+    }
+#endif
+
+    return HandleMessage(std::move(doc), handler);
+}
+
+LSPRet WasmTransport::Loop(MessageHandler &handler)
+{
+    Logger &logger = Logger::Instance();
+    std::stringstream log;
+
+    while (!exitRequested) {
+        std::string json;
+        {
+            std::unique_lock<std::mutex> lock(queueMutex);
+            queueCondition.wait(lock, [this] {
+                return !messageQueue.empty() || exitRequested;
+            });
+
+            if (exitRequested && messageQueue.empty()) {
+                break;
+            }
+
+            if (!messageQueue.empty()) {
+                json = messageQueue.front();
+                messageQueue.pop();
+            }
+        }
+
+        if (json.empty()) {
+            continue;
+        }
+
+        CleanAndLog(log, "receive message body:" + json);
+        logger.LogMessage(MessageType::MSG_INFO, log.str());
+        logger.CollectMessageInfo(logger.LogInfo(MessageType::MSG_INFO, json));
+
+        nlohmann::json doc;
+#ifndef NO_EXCEPTIONS
+        try {
+#endif
+            doc = nlohmann::json::parse(json);
+#ifndef NO_EXCEPTIONS
+        } catch (nlohmann::detail::parse_error &errs) {
+            CleanAndLog(log, errs.what());
+            logger.LogMessage(MessageType::MSG_WARNING, log.str());
+            continue;
+        }
+#endif
+
+        LSPRet ret = HandleMessage(std::move(doc), handler);
+        if (ret == LSPRet::NORMAL_EXIT || ret == LSPRet::ABNORMAL_EXIT) {
+            return ret;
+        }
+    }
+
+    return LSPRet::NORMAL_EXIT;
+}
+
+LSPRet WasmTransport::HandleMessage(nlohmann::json message, MessageHandler &handler)
+{
+    Logger &logger = Logger::Instance();
+
+    // Message must be an object with "jsonrpc":"2.0".
+    if (message["jsonrpc"].is_null() || message.value("jsonrpc", "") != "2.0") {
+        logger.LogMessage(MessageType::MSG_WARNING, "jsonrpc is null or not 2.0.");
+        return LSPRet::ERR_JSON;
+    }
+
+    nlohmann::json id = nullptr;
+    if (!message["id"].is_null()) {
+        id = std::move(message["id"]);
+    }
+
+    // call or notify
+    if (!message["method"].is_null()) {
+        std::string method = message.value("method", "");
+
+        if (method == "exit") {
+            if (ShutdownRequested()) {
+                return LSPRet::NORMAL_EXIT;
+            }
+            return LSPRet::ABNORMAL_EXIT;
+        }
+
+        nlohmann::json params = nullptr;
+        if (message["params"].is_object()) {
+            params = std::move(message["params"]);
+        }
+
+        if (id.is_null()) {
+            return handler.OnNotify(method, std::move(params));
+        }
+        return handler.OnCall(method, std::move(params), std::move(id));
+    }
+
+    if (id.is_null()) {
+        std::stringstream log;
+        log << "No method and no response ID, message: " << message;
+        logger.LogMessage(MessageType::MSG_WARNING, log.str());
+        return LSPRet::ERR_JSON;
+    }
+
+    // reply
+    if (!message["error"].is_null()) {
+        return handler.OnReply(std::move(id),
+                               ValueOrError(ValueOrErrorCheck::ERR, DecodeError(message["error"])));
+    }
+
+    nlohmann::json jsonValue = nullptr;
+    if (!message["result"].is_null()) {
+        jsonValue = std::move(message["result"]);
+    }
+    return handler.OnReply(std::move(id), ValueOrError(ValueOrErrorCheck::VALUE, jsonValue));
+}
+
+} // namespace ark
+
+#endif // BUILD_WASM
diff --git a/cangjie_tools/cangjie-language-server/src/wasm/WasmTransport.h b/cangjie_tools/cangjie-language-server/src/wasm/WasmTransport.h
new file mode 100644
index 00000000..dbefbe48
--- /dev/null
+++ b/cangjie_tools/cangjie-language-server/src/wasm/WasmTransport.h
@@ -0,0 +1,109 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2025. All rights reserved.
+// This source file is part of the Cangjie project, licensed under Apache-2.0
+// with Runtime Library Exception.
+//
+// See https://cangjie-lang.cn/pages/LICENSE for license information.
+
+#ifndef LSPSERVER_WASMTRANSPORT_H
+#define LSPSERVER_WASMTRANSPORT_H
+
+#ifdef BUILD_WASM
+
+#include <iostream>
+#include <sstream>
+#include <queue>
+#include <mutex>
+#include <condition_variable>
+
+#include <emscripten.h>
+#include <emscripten/bind.h>
+
+#include "../json-rpc/Transport.h"
+
+namespace ark {
+
+// Callback function type for sending messages to JavaScript
+using JsMessageCallback = void (*)(const char *);
+
+class WasmTransport : public Transport {
+public:
+    static WasmTransport &Instance()
+    {
+        static WasmTransport instance{};
+        return instance;
+    }
+
+    // Transport interface implementation
+    void SetIO(std::FILE *in, std::FILE *out) override
+    {
+        // Not used in WASM - communication is via embind
+    }
+
+    void Notify(std::string method, ValueOrError params) override;
+
+    void Reply(nlohmann::json id, ValueOrError result) override;
+
+    LSPRet Loop(MessageHandler &handler) override;
+
+    // JavaScript interface methods
+    void ReceiveMessage(const std::string &message);
+
+    // Set the callback for sending messages to JavaScript
+    void SetMessageCallback(JsMessageCallback callback)
+    {
+        jsCallback = callback;
+    }
+
+    // Process a single message (non-blocking, for use with embind)
+    LSPRet ProcessSingleMessage(MessageHandler &handler);
+
+    // Check if there are pending messages
+    bool HasPendingMessages() const
+    {
+        std::lock_guard<std::mutex> lock(queueMutex);
+        return !messageQueue.empty();
+    }
+
+    // Request exit from the message loop
+    void RequestExit()
+    {
+        exitRequested = true;
+        queueCondition.notify_all();
+    }
+
+    ~WasmTransport() override {}
+
+private:
+    WasmTransport() : jsCallback(nullptr), exitRequested(false) {}
+    WasmTransport(const WasmTransport &) = delete;
+    const WasmTransport &operator=(const WasmTransport &) = delete;
+
+    // Send a JSON message to JavaScript
+    void SendToJS(const nlohmann::json &message);
+
+    // Handle a parsed JSON message
+    LSPRet HandleMessage(nlohmann::json message, MessageHandler &handler);
+
+    // Encode error to JSON
+    static nlohmann::json EncodeError(const MessageErrorDetail &errorInfo);
+
+    // Decode error from JSON
+    static MessageErrorDetail DecodeError(const nlohmann::json &o);
+
+    // Message queue for receiving messages from JavaScript
+    std::queue<std::string> messageQueue;
+    mutable std::mutex queueMutex;
+    std::condition_variable queueCondition;
+
+    // Callback to send messages to JavaScript
+    JsMessageCallback jsCallback;
+
+    // Flag to request exit from Loop
+    std::atomic<bool> exitRequested;
+};
+
+} // namespace ark
+
+#endif // BUILD_WASM
+
+#endif // LSPSERVER_WASMTRANSPORT_H
diff --git a/cangjie_tools/cangjie-language-server/src/wasm/wasm_main.cpp b/cangjie_tools/cangjie-language-server/src/wasm/wasm_main.cpp
new file mode 100644
index 00000000..10a89193
--- /dev/null
+++ b/cangjie_tools/cangjie-language-server/src/wasm/wasm_main.cpp
@@ -0,0 +1,234 @@
+// Copyright (c) Huawei Technologies Co., Ltd. 2025. All rights reserved.
+// This source file is part of the Cangjie project, licensed under Apache-2.0
+// with Runtime Library Exception.
+//
+// See https://cangjie-lang.cn/pages/LICENSE for license information.
+
+#ifdef BUILD_WASM
+
+#include <emscripten.h>
+#include <emscripten/bind.h>
+#include <memory>
+#include <string>
+#include <thread>
+
+#include <cangjie/Basic/Version.h>
+
+#include "WasmTransport.h"
+#include "../languageserver/ArkLanguageServer.h"
+#include "../languageserver/logger/Logger.h"
+#include "../languageserver/capabilities/shutdown/Shutdown.h"
+#include "../languageserver/common/Utils.h"
+
+using namespace Cangjie::FileUtil;
+
+namespace {
+
+// Global LSP server instance
+std::unique_ptr<ark::ArkLanguageServer> g_lspServer;
+ark::Environment g_environment;
+bool g_initialized = false;
+bool g_serverLoopRunning = false;
+std::thread g_serverThread;
+
+// Callback function to send messages to JavaScript (proxied to main thread)
+extern "C" {
+    EMSCRIPTEN_KEEPALIVE
+    void wasmSendMessage(const char *message)
+    {
+        // NOTE: Use bracket-string property access so Closure Compiler
+        // (--closure 1) does not mangle the user-facing callback name.
+        // Dot access like Module.onLSPMessage gets renamed (e.g. Module.uc),
+        // which breaks consumers that assign Module['onLSPMessage'] = handler.
+        MAIN_THREAD_EM_ASM({
+            if (typeof Module['onLSPMessage'] === 'function') {
+                Module['onLSPMessage'](UTF8ToString($0));
+            } else {
+                console.log('LSP Response:', UTF8ToString($0));
+            }
+        }, message);
+    }
+}
+
+} // anonymous namespace
+
+// Initialize the LSP server
+void initLSP()
+{
+    if (g_initialized) {
+        Trace::Log("LSP already initialized");
+        return;
+    }
+
+    Trace::Log("Initializing WASM LSP Server");
+
+    // Set up environment (WASM has limited environment access)
+    g_environment.cangjiePath = "/cangjie";
+    g_environment.cangjieHome = "/cangjie";
+    g_environment.runtimePath = "";
+
+    ark::CompilerCangjieProject::SetUseDB(false);
+
+    // Register WasmTransport
+    ark::TransportRegistrar<ark::Transport, ark::WasmTransport> wasmTransportRegistrar("wasm");
+    wasmTransportRegistrar.Regist();
+
+    // Set the message callback
+    ark::WasmTransport::Instance().SetMessageCallback(wasmSendMessage);
+
+    // Create the LSP server
+    g_lspServer =
+        std::make_unique<ark::ArkLanguageServer>(ark::WasmTransport::Instance(), g_environment, nullptr);
+
+    g_initialized = true;
+    Trace::Log("WASM LSP Server initialized");
+}
+
+// Initialize with custom paths
+void initLSPWithPaths(const std::string &cangjiePath, const std::string &cangjieHome)
+{
+    if (g_initialized) {
+        Trace::Log("LSP already initialized");
+        return;
+    }
+
+    Trace::Log("Initializing WASM LSP Server with custom paths");
+
+    g_environment.cangjiePath = cangjiePath;
+    g_environment.cangjieHome = cangjieHome;
+    g_environment.runtimePath = "";
+
+    ark::CompilerCangjieProject::SetUseDB(false);
+
+    ark::TransportRegistrar<ark::Transport, ark::WasmTransport> wasmTransportRegistrar("wasm");
+    wasmTransportRegistrar.Regist();
+
+    ark::WasmTransport::Instance().SetMessageCallback(wasmSendMessage);
+
+    g_lspServer =
+        std::make_unique<ark::ArkLanguageServer>(ark::WasmTransport::Instance(), g_environment, nullptr);
+
+    g_initialized = true;
+    Trace::Log("WASM LSP Server initialized with custom paths");
+}
+
+// Process a single message from JavaScript
+// If server loop is running (async mode), just queue the message
+// Otherwise, process synchronously (not recommended, will block UI)
+void processMessage(const std::string &message)
+{
+    if (!g_initialized) {
+        EM_ASM({ console.error("LSP not initialized. Call initLSP() first."); });
+        return;
+    }
+
+    // Put message in queue
+    ark::WasmTransport::Instance().ReceiveMessage(message);
+
+    // If server loop is running, the background thread will process it
+    // Otherwise, process synchronously (blocks UI - not recommended)
+    if (!g_serverLoopRunning && g_lspServer) {
+        g_lspServer->ProcessSingleMessage();
+    }
+}
+
+// Start the LSP server loop in a separate thread (requires pthreads)
+void startServerLoop()
+{
+    if (!g_initialized) {
+        EM_ASM({ console.error("LSP not initialized. Call initLSP() first."); });
+        return;
+    }
+
+    if (g_serverLoopRunning) {
+        Trace::Log("Server loop already running");
+        return;
+    }
+
+    g_serverLoopRunning = true;
+
+    g_serverThread = std::thread([]() {
+        Trace::Log("Starting LSP server loop in background thread");
+        Cangjie::ICE::TriggerPointSetter iceSetter(Cangjie::ICE::LSP_TP);
+        ark::LSPRet exitCode = g_lspServer->Run();
+
+        g_serverLoopRunning = false;
+
+        if (exitCode == ark::LSPRet::NORMAL_EXIT) {
+            Trace::Log("LSP finished normally");
+        } else if (exitCode == ark::LSPRet::ABNORMAL_EXIT) {
+            Trace::Wlog("LSP exited abnormally");
+        }
+    });
+    g_serverThread.detach();
+
+    Trace::Log("Server loop started in background thread");
+}
+
+// Stop the LSP server
+void stopServer()
+{
+    if (!g_initialized) {
+        return;
+    }
+
+    Trace::Log("Stopping WASM LSP Server");
+    ark::WasmTransport::Instance().RequestExit();
+}
+
+// Shutdown and cleanup
+void shutdownLSP()
+{
+    if (!g_initialized) {
+        return;
+    }
+
+    Trace::Log("Shutting down WASM LSP Server");
+    stopServer();
+
+    g_lspServer.reset();
+    g_initialized = false;
+    g_serverLoopRunning = false;
+}
+
+// Check if the server is initialized
+bool isInitialized()
+{
+    return g_initialized;
+}
+
+// Check if the server loop is running
+bool isServerLoopRunning()
+{
+    return g_serverLoopRunning;
+}
+
+// Get version information
+std::string getVersion()
+{
+    return std::string(Cangjie::CANGJIE_VERSION);
+}
+
+// Emscripten bindings to expose functions to JavaScript
+// Note: For filesystem operations, use Module.FS directly in JavaScript
+EMSCRIPTEN_BINDINGS(cangjie_lsp) {
+    emscripten::function("initLSP", &initLSP);
+    emscripten::function("initLSPWithPaths", &initLSPWithPaths);
+    emscripten::function("processMessage", &processMessage);
+    emscripten::function("startServerLoop", &startServerLoop);
+    emscripten::function("stopServer", &stopServer);
+    emscripten::function("shutdownLSP", &shutdownLSP);
+    emscripten::function("isInitialized", &isInitialized);
+    emscripten::function("isServerLoopRunning", &isServerLoopRunning);
+    emscripten::function("getVersion", &getVersion);
+}
+
+// Main function for WASM (minimal, initialization happens via embind)
+int main()
+{
+    Trace::Log("WASM LSP module loaded");
+
+    return 0;
+}
+
+#endif // BUILD_WASM
